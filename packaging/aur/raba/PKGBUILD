# Maintainer: Bruno Correia <bhcorreia11@gmail.com>
#
# Three packages out of one source tree, which is the layout docs/packaging.md
# argues for: the program, the art and the authoring tool are three different
# kinds of thing. The split is not about size — the 50 logos together are
# 464 KiB, and only one of them ever enters an initramfs — it is so that a
# trademark complaint about a logo touches one package and not the splash.

pkgbase=raba
pkgname=('raba' 'raba-themes' 'raba-gen')
pkgver=0.1.0
pkgrel=1
arch=('x86_64' 'aarch64')
url="https://github.com/brunohcorreia/raba"
license=('GPL-3.0-or-later')
makedepends=('cargo' 'scdoc' 'make')
source=("$pkgbase-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# Replaced with the real digest when the tag exists; `updpkgsums` writes it.
sha256sums=('SKIP')

prepare() {
    cd "$pkgbase-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
    cd "$pkgbase-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    # The Makefile, so that this recipe and a `make install` on a distribution
    # with no package of its own cannot disagree about where anything goes.
    make all CARGO_FLAGS="--frozen --release"
}

check() {
    cd "$pkgbase-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo test --frozen --release --workspace
}

package_raba() {
    pkgdesc="ASCII boot splash: a terminal animation from the initramfs to the login screen"
    depends=('glibc' 'gcc-libs')
    optdepends=('raba-themes: logo art for 50 distributions'
                'raba-gen: build your own animations'
                'mkinitcpio: initramfs hook (Arch and derivatives)'
                'dracut: initramfs module'
                'systemd: packaged start/quit units')
    backup=('etc/raba/raba.conf')
    install=raba.install

    cd "$pkgbase-$pkgver"
    make install-raba install-pacman-hook DESTDIR="$pkgdir"
}

package_raba-themes() {
    pkgdesc="Logo animations for RABA, 50 distributions"
    arch=('any')
    optdepends=('raba: the splash that plays them')

    # Art adapted from fastfetch (MIT). Distribution logos are trademarks of
    # their respective projects; themes/README.md ships with them and says so.
    cd "$pkgbase-$pkgver"
    make install-themes DESTDIR="$pkgdir"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/raba-themes/LICENSE"
}

package_raba-gen() {
    pkgdesc="Build RABA animations from ASCII art, ANSI art and Durdraw files"
    depends=('glibc' 'gcc-libs')
    optdepends=('raba: the splash that plays what this builds')

    cd "$pkgbase-$pkgver"
    make install-gen DESTDIR="$pkgdir"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/raba-gen/LICENSE"
}
