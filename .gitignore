# Rust
/target/
**/*.rs.bk
*.pdb

# Cargo.lock IS committed — this produces binaries, not a library.

# Fuzzing
/fuzz/target/
/fuzz/artifacts/
/fuzz/coverage/

# Generated animations — themes are built from recipes in themes/*.toml
*.raba
!tests/fixtures/**/*.raba

# Generated man pages — sources are man/*.scd
/man/*.1
/man/*.5
/man/*.8
!/man/*.scd

# Test environment. Everything a VM run leaves behind lands in target/, which is
# already ignored; these catch a stray copy anywhere else.
*.qcow2
*.img
*.ppm

# Python bytecode. The scripts in scripts/ are imported by other scripts — the
# frame classifier is used by both the distribution tests and the recorder — and
# importing a module writes a .pyc next to it. Two of them reached a commit
# before this line existed.
__pycache__/
*.pyc

# Build and packaging output
*.pkg.tar.*
/pkg/
/src/
!/crates/*/src/

# Editors
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Local overrides
/.env
/local/

# cargo-fuzz keeps its own lockfile
/fuzz/Cargo.lock
