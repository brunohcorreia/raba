#!/usr/bin/ash
# RABA's mkinitcpio runtime hook: a busybox initramfs, running as PID 1's child.
# SPDX-License-Identifier: GPL-3.0-or-later

run_hook() {
    # Backgrounded, because /init calls this and the boot has to carry on. The
    # splash is a child of PID 1 from here until something kills it, and being
    # killed is not an event: /run/raba.state carries the terminal and the frame
    # across switch_root, and whatever starts next picks the animation back up.
    # See docs/early-boot.md.
    # Output to a file and not to the console: a splash that complains onto
    # the screen it is drawing has defeated itself, and /run survives into the
    # real root, so the complaint is readable after the boot. With no /run the
    # output goes away, never the splash.
    raba_log=/dev/null
    [ -w /run ] && raba_log=/run/raba.early.log
    if command -v raba > /dev/null; then
        raba > "$raba_log" 2>&1 &
    fi
    return 0
}

run_emergencyhook() {
    # The init script is about to drop to a rescue shell. Whatever went wrong,
    # the person about to read the screen needs the screen.
    if command -v raba-ctl > /dev/null; then
        raba-ctl quit --wait
    fi
    return 0
}

# vim: set ft=sh ts=4 sw=4 et:
